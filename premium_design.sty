\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{premium_design}[2024/05/22 Premium Design for Exam Book]

\RequirePackage{xparse}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable,hooks,raster}
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc}
\RequirePackage[explicit]{titlesec}
\RequirePackage{fontawesome}
\RequirePackage{amssymb}

% Compatibility for choiceTFt if not defined
\providecommand{\choiceTFt}{\choiceTF}

% Colors
\definecolor{mainColor}{HTML}{005f73}
\definecolor{secondColor}{HTML}{0a9396}
\definecolor{accentColor}{HTML}{94d2bd}
\definecolor{highlightColor}{HTML}{e9d8a6}
\definecolor{alertColor}{HTML}{ae2012}

% Styles
\tcbset{
    premiumbox/.style={
        enhanced,
        colback=white,
        colframe=#1,
        fonttitle=\bfseries,
        attach boxed title to top left={yshift*=-\tcboxedtitleheight/2, xshift=5mm},
        boxed title style={colback=#1, rounded corners},
        drop fuzzy shadow
    }
}

% Helper to initialize ex-like behavior
\newcommand{\InitPremiumEx}{
    \setcounter{dapan}{0}
    \setcounter{numTrueSol}{0}
    \gdef\saveFileAns{}
    \gdef\keyEX{}
    \gdef\chType{0}
    \def\dotEX{.}
    \SetExEnvironmentOptions
}

% Helper to finish ex-like behavior (write answers, reset)
% Updated to accept an optional argument for the label (default: \thetcbcounter)
\newcommand{\FinishPremiumEx}[1][\thetcbcounter]{
    \ifthenelse{\equal{\saveFileAns}{}}{}{
        \Writetofile{ans}{\string\begin{Solution}{#1}}
        \Writetofile{ans}{\saveFileAns^^J\string\end{Solution}}
    }
    \setcounter{numTrueSol}{0}
    \setcounter{numTrue}{0}
    \gdef\saveFileAns{}\gdef\keyEX{}\gdef\chType{0}
}

% 1. Dinh Nghia (dn)
\newtcolorbox[auto counter, number within=section]{dnbox}[3][]{
    premiumbox=secondColor,
    title={\textbf{Định nghĩa~\thetcbcounter:} #2},
    label={#3},
    #1
}
\DeclareDocumentEnvironment{dn}{ m m }
    {\begin{dnbox}{#1}{#2}}
    {\end{dnbox}}

% 2. Dinh Ly (dl)
\newtcolorbox[auto counter, number within=section]{dlbox}[3][]{
    premiumbox=mainColor,
    title={\textbf{Định lý~\thetcbcounter:} #2},
    label={#3},
    #1
}
\DeclareDocumentEnvironment{dl}{ m m }
    {\begin{dlbox}{#1}{#2}}
    {\end{dlbox}}

% 3. Tinh Chat (tc)
\newtcolorbox[auto counter, number within=section]{tcbox}[3][]{
    premiumbox=accentColor!80!black,
    title={\textbf{Tính chất~\thetcbcounter:} #2},
    label={#3},
    #1
}
\DeclareDocumentEnvironment{tc}{ m m }
    {\begin{tcbox}{#1}{#2}}
    {\end{tcbox}}

% 4. Bai Tap (bt) - Robust Wrapper Strategy
\newtheorem{innerbt}{Bài tập}[section]
\tcolorboxenvironment{innerbt}{
    enhanced,
    colback=white,
    colframe=mainColor,
    fonttitle=\bfseries,
    title={}, 
    boxed title style={empty},
    top=10pt,
    drop fuzzy shadow
}

\NewDocumentEnvironment{bt}{ m m }
    {\begin{innerbt}[#1]\label{#2}\InitPremiumEx}
    {\FinishPremiumEx[\theinnerbt]\end{innerbt}}

% 5. Vi Du (vd) - Robust Wrapper Strategy
\newtheorem{innervd}{Ví dụ}[section]
\tcolorboxenvironment{innervd}{
    enhanced,
    colback=white,
    colframe=secondColor,
    fonttitle=\bfseries,
    title={},
    boxed title style={empty},
    top=10pt,
    drop fuzzy shadow
}

\NewDocumentEnvironment{vd}{ m m }
    {\begin{innervd}[#1]\label{#2}\InitPremiumEx}
    {\FinishPremiumEx[\theinnervd]\end{innervd}}

% Note (No counter)
\DeclareDocumentEnvironment{note}{ }
{
    \begin{tcolorbox}[
        enhanced,
        colback=highlightColor!10,
        colframe=alertColor,
        borderline west={4pt}{0pt}{alertColor},
        frame hidden,
        left=10pt,
        title={\textbf{\faExclamationTriangle\ Chú ý}},
        coltitle=alertColor,
        attach boxed title to top left={yshift=-2mm, xshift=2mm},
        boxed title style={empty, boxsep=0pt},
        fonttitle=\bfseries
    ]
}
{
    \end{tcolorbox}
}

% Dang toan (No counter, custom title)
\DeclareDocumentEnvironment{dang}{ O{} }
{
    \begin{tcolorbox}[
        enhanced,
        colback=white,
        colframe=mainColor,
        fonttitle=\bfseries\large,
        title={#1},
        attach boxed title to top left={yshift=-2mm, xshift=2mm},
        boxed title style={colback=mainColor, sharp corners},
        sharp corners,
        top=4mm,
        drop fuzzy shadow
    ]
}
{
    \end{tcolorbox}
}

% Section Styling
\titleformat{\section}[block]
  {\normalfont\Large\bfseries\color{mainColor}}
  {}
  {0pt}
  {%
    \begin{tikzpicture}[baseline=(current bounding box.west)]
      \node[
        fill=mainColor,
        text=white,
        rounded corners=3pt,
        inner sep=5pt,
        font=\Large\bfseries
      ] (num) {\thesection};
      \node[
        right=5pt of num,
        text=mainColor,
        font=\Large\bfseries,
        align=left
      ] (title) {\MakeUppercase{#1}};
      \draw[mainColor, line width=1.5pt] (title.south west) -- (title.south east);
    \end{tikzpicture}%
  }

\titleformat{\subsection}[block]
  {\normalfont\large\bfseries\color{secondColor}}
  {}
  {0pt}
  {%
    \begin{tikzpicture}[baseline=(current bounding box.west)]
      \node[
        text=secondColor,
        font=\large\bfseries,
        inner sep=0pt,
        align=left
      ] (title) {\thesubsection.~#1};
      \draw[secondColor!50, line width=1pt] (title.south west) -- ([xshift=2cm]title.south west);
    \end{tikzpicture}%
  }

\endinput
