			\setbox0=\vbox{\hbox{
				\noindent\begin{minipage}{\linewidth}%
				\setlength{\parindent}{\paroutindent}##1\end{minipage}
			}}
			\linepar=\ht0
			\pgfmathparse{round((\linepar-\fboxsep)/(\lineheight))}
			\par\noindent\textbf{\loigiaiEX}%
