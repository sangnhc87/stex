% Define inputansbox command for answer table
% Improved version to handle MC, TF, and ShortAns
\newcommand{\inputansbox}[2]{%
    \begin{multicols}{#1}
    % Redefine Solution environment to handle different types
    \renewenvironment{Solution}[1]{%
        \noindent\textbf{##1.}%
        \def\tempLabel{##1}%
        \ignorespaces
    }{%
        \par
    }%
    \input{#2}
    \end{multicols}
}

% Optional: Command to manually set column count for specific parts if needed
% But the user seems to want one command to handle "reasonable design".
