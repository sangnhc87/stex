	#1\dotEX\strut\ignorespaces
	\end{minipage}
	\noindent\hspace{0.02\dorongfix}\begindapan
	#2\dotEX\strut\ignorespaces
	\end{minipage}
	\noindent\hspace{0.02\dorongfix}\begindapan
	#3\dotEX\strut\ignorespaces
	\end{minipage}
	\noindent\hspace{0.02\dorongfix}\begindapan
	#4\dotEX\strut\ignorespaces
	\end{minipage}

}
